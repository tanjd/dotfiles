[user]
	name = tanjd
	email = tanjd@hotmail.com
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFMVc+RJweqNS3Q+j/lHi1w/Edpon9dQo7O3Sn64XnCx

[core]
	editor = code --wait
	autocrlf = input
	filemode = false
	excludesfile = ~/.gitignore_global
	quotepath = false

[init]
	defaultBranch = main

[color]
	ui = auto

[pull]
	rebase = true

[push]
	default = current
	autoSetupRemote = true

[merge]
	conflictstyle = diff3
	log = true

[diff]
	algorithm = histogram
	wordRegex = .
	colorMoved = default

[fetch]
	prune = true
	pruneTags = true

[help]
	autocorrect = prompt

# macOS-specific: uses the native Keychain instead of WSL's plaintext store
[credential]
	helper = osxkeychain

[rebase]
	autoSquash = true
	autoStash = true

[status]
	showUntrackedFiles = all
	showStash = true

[branch]
	sort = -committerdate

[tag]
	sort = version:refname

[log]
	date = local

[rerere]
	enabled = true

[gpg]
	format = ssh

# macOS-specific: 1Password SSH signing (native app, not the WSL bridge binary)
[gpg "ssh"]
	program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
	allowedSignersFile = ~/.config/git/allowed_signers

[commit]
	gpgsign = true
