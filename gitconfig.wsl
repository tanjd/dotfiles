[user]
	name = tanjd
	email = tanjd@hotmail.com
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFMVc+RJweqNS3Q+j/lHi1w/Edpon9dQo7O3Sn64XnCx

[core]
	editor = code --wait
	autocrlf = input
	sshCommand = ssh.exe # WSL-specific
	filemode = false
	excludesfile = ~/.gitignore_global
	quotepath = false

[init]
	defaultBranch = main

[color]
	ui = auto

[pull]
	rebase = true

[push]
	default = current
	autoSetupRemote = true

[merge]
	conflictstyle = diff3
	log = true

[diff]
	algorithm = histogram
	wordRegex = .
	colorMoved = default

[fetch]
	prune = true
	pruneTags = true

[help]
	autocorrect = prompt

# WSL-specific: on macOS the default osxkeychain is used instead
[credential]
	helper = store

[rebase]
	autoSquash = true
	autoStash = true

[status]
	showUntrackedFiles = all
	showStash = true

[branch]
	sort = -committerdate

[tag]
	sort = version:refname

[log]
	date = local

[rerere]
	enabled = true

[gpg]
	format = ssh

# WSL-specific: 1Password SSH signing
[gpg "ssh"]
	program = "/mnt/c/Users/tanjd/AppData/Local/Microsoft/WindowsApps/op-ssh-sign-wsl.exe"
	allowedSignersFile = /home/tanjd/.config/git/allowed_signers

[commit]
	gpgsign = true


